"""Kaggle GPU server for isaacli with optional reusable private inputs."""
import os
import re
import shutil
import subprocess
import tempfile
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

MODEL_REPO = "__MODEL_REPO__"
MODEL_FILE = "__MODEL_FILE__"
MODEL_ALIAS = "__MODEL_ALIAS__"
API_KEY = "__API_KEY__"
CUDA_ARCH = "__CUDA_ARCH__"
MACHINE_SHAPE = "__MACHINE_SHAPE__"
GPU_COUNT = __GPU_COUNT__
SPLIT_MODE = "__SPLIT_MODE__"
CONTEXT = __CONTEXT__
# llama-server's own log level, and 3 is the level it picks for itself. It is a
# parameter because of what level 4 turns out to contain, measured 2026-09-08 on
# T4 x2 with Qwen3.8-27B:
#
#   Loading the model at 3 prints 61 lines and not one `load_tensors:` among
#   them. At 4 it prints 290, including `load_tensors: offloaded 66/66 layers to
#   GPU` and every buffer size llama.cpp allocates. Those are the numbers that
#   let hardware.py's estimate be checked against something declared rather than
#   inferred from nvidia-smi.
#
#   Serving at 4 costs 36.9 extra lines per request. Two hundred agent steps
#   would add some 7400 lines to the same stdout the tunnel URL is read from.
#
# So 4 is an instrument and 3 is how you work, and the renderer only passes -lv
# at all when somebody asked for something other than 3: the default has to
# produce the command line that was already being sent, unchanged.
SERVER_VERBOSITY = __SERVER_VERBOSITY__
# The ceiling agreed at the push, in seconds, and the only brake on this
# session that does not need anybody on the other side to be alive. On
# 2026-08-23 the window conducting a run was cut off by an API limit while the
# kernel was serving, and the kernel kept billing for four hours for nobody.
# The clock starts here, at the top of the script, because loading tens of
# gigabytes bills exactly like serving does.
SESSION_SECONDS = __SESSION_SECONDS__
# How long a poll can leave this script asleep past the moment the ceiling was
# reached, plus how long ending the session is allowed to take. Both are the
# figures used further down rather than numbers chosen here: the serving loop
# sleeps this long between checks, and end_session gives each of its two
# children this long to go quietly.
CEILING_POLL_SECONDS = 30
CEILING_SHUTDOWN_SECONDS = 2 * 30
# The same ceiling as `kernels push -t`, minus the time it takes to notice and
# to act on it. Measured on 2026-09-09: with both sides carrying the identical
# figure, Kaggle's server-side timeout won by four seconds. Its log stops
# mid-sentence at 120 minutes and 4 seconds, there is no [shutdown] line, and
# the kernel is left CANCEL_ACKNOWLEDGED instead of COMPLETE, so the one record
# of why a two hour session ended is a gap. Whoever fires first is otherwise
# decided by nothing but polling granularity. Ending slightly early is strictly
# cheaper than the ceiling that was agreed and it is the only one of the two
# that writes down its reason, so it is the one that should win.
SESSION_ENDS_AT = (time.monotonic() + SESSION_SECONDS
                   - CEILING_POLL_SECONDS - CEILING_SHUTDOWN_SECONDS)
# The other half of the same brake, and the one the incident actually called
# for. The wall ceiling answers "this may never cost more than N hours"; this
# answers "and it stops as soon as nobody is on the other end". The client
# beats while its session is open, so the beats stop when the terminal is
# closed, killed, cut off from the network, or interrupted, which is every way
# the window that launched a kernel has been lost so far.
IDLE_SECONDS = __IDLE_SECONDS__
PORT = 8080
# The attached inputs are read-only and already expanded by Kaggle.
SCRATCH = tempfile.gettempdir()


def run(command):
    subprocess.run(command, check=True)


def input_file(name):
    matches = list(Path("/kaggle/input").rglob(name))
    if len(matches) != 1:
        raise RuntimeError(f"expected one attached {name}, found {len(matches)}")
    return matches[0]


runtime_root = Path(SCRATCH) / f"llama-cuda-sm{CUDA_ARCH}-b10502"


def optional_input(name):
    matches = list(Path("/kaggle/input").rglob(name))
    return matches[0] if len(matches) == 1 else None


# Every step below is minutes long and used to print nothing at all, so an
# empty log looked exactly like a dead kernel. It is not: reading a 24 GB
# weight off the attached dataset is silent work that bills GPU time. Two
# kernels were deleted on 2026-08-21 for being "stuck" while they were loading,
# so each stage now names itself before it starts.
def stage(message):
    print(f"[setup] {message}", flush=True)


# What the cards really hold, and what is really on them, said out loud.
#
# The context a launch may ask for is decided here on the client from a nominal
# VRAM figure and a reserve for the runtime's own buffers, and neither of those
# had ever been checked against a card. They cannot be checked from the client:
# the only place the truth exists is inside the session, and the only record
# that leaves it is this log. llama.cpp does print its buffer sizes, but Kaggle
# keeps a few dozen log records out of the whole run and drops them, so the
# measurement has to be a stdout line of our own to survive. Printed twice on
# purpose: before the server starts, which is the cost of the CUDA context
# alone and is the only reading that survives a load that dies out of memory,
# and again once the server answers, which is weights plus cache plus runtime.
def report_vram(moment):
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=index,memory.total,memory.used",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as error:
        print(f"[vram] {moment}: nvidia-smi did not answer: {error}", flush=True)
        return
    if result.returncode != 0:
        print(f"[vram] {moment}: nvidia-smi failed: "
              f"{(result.stderr or result.stdout).strip()}", flush=True)
        return
    # Spelled out rather than written as a ratio: "gpu0=15360/0" reads as used
    # over total to everyone who did not write it, and it is the other way
    # round. A reading nobody can misread is the whole point of taking it.
    readings = []
    for line in result.stdout.strip().splitlines():
        if not line.strip():
            continue
        fields = [part.strip() for part in line.split(",")]
        if len(fields) != 3:
            # A reading is worth a launch only if taking it cannot cost one.
            # This runs before the server starts, so an exception here would
            # end a kernel that has already been pushed and paid for.
            readings.append(f"unreadable({line.strip()})")
            continue
        index, total, used = fields
        readings.append(f"gpu{index} used {used} MiB of {total} MiB")
    print(f"[vram] {moment}: {' '.join(readings)}", flush=True)


archive = optional_input(f"llama-cuda-sm{CUDA_ARCH}-b10502.tar.gz")
mounted_server = optional_input("llama-server")
if archive:
    stage("extracting the prepared runtime archive")
    run(["tar", "-xzf", str(archive), "-C", SCRATCH])
elif mounted_server:
    stage("copying the prepared runtime from the attached dataset")
    shutil.copytree(mounted_server.parent.parent, runtime_root, dirs_exist_ok=True)
else:
    stage("no prepared runtime attached, building llama.cpp from source")
    source_dir = Path(SCRATCH) / "llama.cpp"
    run(["git", "clone", "--depth", "1", "--branch", "b10502",
         "https://github.com/ggml-org/llama.cpp", str(source_dir)])
    cuda_driver_candidates = [
        "/usr/local/nvidia/lib64/libcuda.so.1",
        "/usr/lib/x86_64-linux-gnu/libcuda.so.1",
        "/usr/local/cuda/lib64/stubs/libcuda.so",
    ]
    cuda_driver = next(
        (path for path in cuda_driver_candidates if os.path.isfile(path)), None)
    if not cuda_driver:
        raise RuntimeError("CUDA driver library not found")
    run(["cmake", "-S", str(source_dir), "-B", str(source_dir / "build"),
         "-DGGML_CUDA=ON", f"-DCMAKE_CUDA_ARCHITECTURES={CUDA_ARCH}",
         f"-DCUDA_cuda_driver_LIBRARY={cuda_driver}"])
    run(["cmake", "--build", str(source_dir / "build"), "--config",
         "Release", "-j4", "--target", "llama-server"])
    runtime_root.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source_dir / "build" / "bin", runtime_root / "bin")

server_binary = runtime_root / "bin" / "llama-server"
server_binary.chmod(0o755)
model_path = optional_input(MODEL_FILE)
if model_path is None:
    # This branch is the expensive one and it is chosen silently by a name that
    # did not match. Say so, because downloading the weight inside the kernel
    # has been measured as low as 5.7 MB/s and can cost more quota than the
    # whole session that follows it.
    stage(f"{MODEL_FILE} is not attached, downloading it from {MODEL_REPO}")
    model_path = Path(SCRATCH) / MODEL_FILE
    run(["curl", "-fL", "-o", str(model_path),
         f"https://huggingface.co/{MODEL_REPO}/resolve/main/{MODEL_FILE}"])
else:
    stage(f"using the attached weight at {model_path}")
def library_path(root):
    """Every directory of the prepared runtime that holds a shared object.

    llama.cpp keeps its own shared libraries next to the binary in bin/, while
    the CUDA runtime lands in lib/, and the RPATH baked into the binary names
    the directory it was compiled in, which does not exist in this session. A
    runtime that arrived as a prepared input is therefore only loadable if the
    search path is derived from the tree that actually arrived: naming lib/
    alone left llama-server unable to open libllama-server-impl.so, after the
    weights had already been downloaded.
    """
    return os.pathsep.join(sorted(
        {str(path.parent) for path in root.rglob("*.so*")}))


server_env = dict(os.environ)
server_env["LD_LIBRARY_PATH"] = os.pathsep.join(
    part for part in (library_path(runtime_root),
                      server_env.get("LD_LIBRARY_PATH", "")) if part)
server_command = [
    str(server_binary),
    "-m", str(model_path), "--alias", MODEL_ALIAS, "-ngl", "99",
    "-c", str(CONTEXT),
    "--host", "127.0.0.1", "--port", str(PORT),
    "--jinja", "--api-key", API_KEY,
    # The counter behind the dead-man's switch. Without this flag /metrics
    # answers 501 and the only sign a request ever happened is a log line, and
    # this build writes none: five GET /v1/models against b10502 on 2026-09-08
    # left the log at exactly the length it started, and every counter here at
    # zero, which is why the switch had never once armed.
    "--metrics",
]
if SERVER_VERBOSITY != 3:
    server_command.extend(["-lv", str(SERVER_VERBOSITY)])
if GPU_COUNT > 1:
    # Splitting layers across cards buys capacity, not speed: for one request
    # at a time, one card computes while the other waits. It is asked for only
    # when the weights plus cache do not fit on a single card.
    server_command.extend(["--split-mode", SPLIT_MODE])
stage("starting llama-server, which reads the whole weight before it answers")
# The two figures the client used to decide this context, so the log carries
# everything the subtraction needs without having to look anything up.
print(f"[vram] plan: weight={model_path.stat().st_size} bytes context={CONTEXT} "
      f"gpu_count={GPU_COUNT}", flush=True)
report_vram("before the server starts")

# Whoever is on the other end of the tunnel is only visible here through
# llama-server's own request log. This kernel cannot see cloudflared's traffic
# and llama-server is not ours to instrument, but it announces every request it
# serves, and that announcement is the proof that somebody is still there.
last_request = [None]
last_request_lock = threading.Lock()


def watch_server_log(stream):
    """Pass llama-server's log through, stamping when a request arrives.

    Every line is echoed unchanged: this log is also the only account of what
    the session did, and Kaggle keeps only a few dozen records of it, so
    swallowing lines here would cost the next investigation its evidence.
    """
    # Also kept on disk, because the screen is not storage. Kaggle retains only
    # the last few dozen records of a kernel's output, and what falls off the
    # front is the model load, which is where llama.cpp says
    # `offloaded N/N layers to GPU`. That line has never been read in a Kaggle
    # run of this program: a search for "offload" in the log of the 2026-08-20
    # measurement matched nothing, and the conclusion that the model was
    # entirely on the cards was reached by inference from nvidia-smi instead.
    # /kaggle/working survives the session and `kernels output` returns it.
    log_path = Path("/kaggle/working/llama-server.log")
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        sink = log_path.open("a", encoding="utf-8")
    except OSError:
        sink = None
    try:
        for line in stream:
            if "request: " in line:
                with last_request_lock:
                    last_request[0] = time.monotonic()
            if sink is not None:
                sink.write(line)
                sink.flush()
            print(line, end="", flush=True)
    finally:
        if sink is not None:
            sink.close()


# A pipe turns llama-server's own C stdout from line buffered into block
# buffered, and a stamp that arrives a block late is a live session that looks
# idle. `stdbuf` is how you tell a C program otherwise from the outside, and it
# is coreutils, so it is there. When it is not, the switch is left unarmed
# rather than armed on stamps that cannot be trusted: unarmed can only fail
# towards spending the ceiling that was agreed, and armed on bad timing would
# end a session somebody is using. A layer that disappears has to say so.
line_buffered = ["stdbuf", "-oL", "-eL"] if shutil.which("stdbuf") else []
if line_buffered:
    server = subprocess.Popen(
        line_buffered + server_command, env=server_env,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    threading.Thread(
        target=watch_server_log, args=(server.stdout,), daemon=True).start()
else:
    print("NOTE: stdbuf is missing, so this session cannot watch its own request "
          f"log. It will not end itself when the client goes quiet; only the "
          f"{SESSION_SECONDS} s ceiling applies.", flush=True)
    server = subprocess.Popen(server_command, env=server_env)

cloudflared = f"{SCRATCH}/cloudflared"
mounted_cloudflared = optional_input("cloudflared-linux-amd64")
if mounted_cloudflared:
    shutil.copy2(mounted_cloudflared, cloudflared)
elif (runtime_root / "cloudflared-linux-amd64").exists():
    shutil.copy2(runtime_root / "cloudflared-linux-amd64", cloudflared)
else:
    run(["curl", "-fL", "-o", cloudflared,
         "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64"])
run(["chmod", "+x", cloudflared])
tunnel = subprocess.Popen(
    [cloudflared, "tunnel", "--url", f"http://127.0.0.1:{PORT}"],
    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
)

# Everything cloudflared says, from its first line, kept instead of dropped.
# The pipe has to be drained or the process blocks on a full buffer, but
# draining it into nothing threw away the only account of what the transport
# did: QUIC failing, a retry, a datacenter change. A session was measured at
# 39 s to first byte while the server behind it answered the same call in
# 0.874 s, and this file is where the reason for that would have been.
# /kaggle/working is what `kernels output` returns, so it survives the session;
# it is never printed, because a screen somebody is watching for a URL is not
# the place for it.
TUNNEL_LOG = Path("/kaggle/working/cloudflared.log")
# The URL cloudflared publishes, filled in by the reader thread below.
tunnel_url = [None]


def read_tunnel_log(stream, path):
    """Keep every cloudflared line, and pick the published URL out of it.

    One reader instead of two phases. Reading the URL out of this pipe in the
    main line and only then starting a keeper thread dropped every line before
    the URL, and, worse, left the only wait in this script that no brake could
    end: iterating cloudflared's pipe there blocks until it writes or exits, so
    a tunnel that came up and never published would bill the whole session with
    neither the ceiling nor the silence switch ever being polled. The
    blocking read now lives in a thread nobody waits on, and the main line
    polls for the URL under the same brakes as every other wait here.
    """
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        sink = path.open("a", encoding="utf-8")
    except OSError:
        # Losing the log costs diagnosis; losing the drain costs the session.
        sink = None
    try:
        for entry in stream:
            if tunnel_url[0] is None:
                match = re.search(r"https://[-a-z0-9]+\.trycloudflare\.com",
                                  entry)
                if match:
                    tunnel_url[0] = match.group(0)
            if sink is not None:
                sink.write(entry)
                sink.flush()
    finally:
        if sink is not None:
            sink.close()


threading.Thread(target=read_tunnel_log, args=(tunnel.stdout, TUNNEL_LOG),
                 daemon=True).start()


# The counter the switch reads, and the reason it is a counter rather than a
# line of log. A log format belongs to somebody else and can change between two
# builds without anybody noticing that a brake stopped existing; a number that
# only goes up is a contract. Measured locally against the same build the kernel
# runs, 10502 / 0adcc3bb5: five GET /v1/models move nothing at all, and one
# /v1/completions with max_tokens 1 moves n_decode_total by exactly 1, twice in
# a row on an identical prompt. So the client's beat is one such call, and this
# is the kernel seeing it land.
DECODES = re.compile(r"^llamacpp:n_decode_total\s+([0-9]+)", re.M)


def decodes_served():
    """How many decodes this server has run, or None if it will not say."""
    request = urllib.request.Request(
        f"http://127.0.0.1:{PORT}/metrics",
        headers={"Authorization": "Bearer " + API_KEY})
    try:
        with urllib.request.urlopen(request, timeout=10) as answer:
            match = DECODES.search(answer.read().decode("utf-8", "replace"))
    except (urllib.error.URLError, OSError, TimeoutError, ValueError):
        return None
    return int(match.group(1)) if match else None


def serving():
    """True once llama-server answers, which is not the same as being up."""
    request = urllib.request.Request(
        f"http://127.0.0.1:{PORT}/v1/models",
        headers={"Authorization": "Bearer " + API_KEY})
    try:
        with urllib.request.urlopen(request, timeout=10) as answer:
            return answer.status == 200
    except (urllib.error.URLError, OSError, TimeoutError):
        return False


# The URL is what isaacli turns into a ready profile, so it is published only
# after the server answers. cloudflared publishes its URL in seconds while
# loading tens of gigabytes of weights takes minutes, and announcing the tunnel
# first would hand the user a profile whose first request fails.
print("Waiting for the model server to answer before publishing the URL",
      flush=True)
def ceiling_reached():
    """Whether the time agreed at the push has run out.

    Checked in both waits below, not only in the serving loop: a load that
    hangs bills at the same rate as a session that serves, and the run this
    ceiling exists for spent most of its hours with nobody reading the answers.
    """
    return time.monotonic() >= SESSION_ENDS_AT


def idle_reached():
    """Whether the other end went quiet for longer than was agreed.

    Armed only once a request has actually been seen. Until then nothing has
    proved this kernel can recognise a request at all, and a dead-man's switch
    allowed to fire without that proof would end a session that was paid for,
    because a log line changed shape in a future llama.cpp build. The wall
    ceiling covers that window, so the unarmed state is never unbounded.

    Arming is not left to the client either: the readiness probe above polls
    this same server while the weights load, so by the time the session is
    published the switch has been armed by traffic this script generated
    itself. What the client's heartbeat then does is keep it from firing.

    What that does not cover, and what the screen must therefore not promise,
    is the load itself. A probe only arms the switch once llama-server answers
    it in its own log, and a server still reading tens of gigabytes off disk
    has no log line to stamp, so a window that dies minutes after the push
    leaves nothing here to notice: on 2026-09-08 a kernel went on loading for
    some fifty minutes after its window was gone, entirely within its ceiling
    and entirely without a client. The ceiling is the brake that covers the
    load, and it is the only one that does.
    """
    with last_request_lock:
        seen = last_request[0]
    return seen is not None and time.monotonic() - seen >= IDLE_SECONDS


def end_session(reason, code=0):
    """Stop billing now, and say why, instead of waiting to be deleted.

    Every way this script can stop leaves through here, failures included. A
    `raise` ends the main line but not the children, and llama-server holding a
    CUDA context is exactly the thing that bills, so an exception used to end
    the account of what happened without ending what it cost. The code says
    whether the session did its job: 0 for a brake that fired as agreed, 1 for
    a launch that could not deliver what it was pushed for.
    """
    print(f"[shutdown] {reason}; ending the session", flush=True)
    for child in (server, tunnel):
        try:
            child.terminate()
            child.wait(timeout=CEILING_SHUTDOWN_SECONDS // 2)
        except (OSError, subprocess.SubprocessError):
            # A child that will not go quietly must not keep the script alive:
            # the point of this path is that the kernel stops billing.
            try:
                child.kill()
            except OSError:
                pass
    raise SystemExit(code)


# A load that hangs bills exactly like a load that works, and the ceiling is
# what bounds it. There used to be a second deadline of one hour here, on the
# theory that a load taking longer than that had hung. That is a calibration,
# and this project has already paid for one: the same step has been measured at
# 3 minutes for a 17.28 GiB weight and over 30 for a 22.53 GiB one, so no
# number invented here separates a slow load from a dead one. The ceiling is
# the bound the user agreed to, it is checked on every pass below, and it is
# the only figure in this script that anybody consented to.
while not serving():
    if server.poll() is not None:
        end_session("the model server exited before it answered", 1)
    if ceiling_reached():
        end_session(f"the agreed ceiling of {SESSION_SECONDS} s ran out while loading")
    time.sleep(10)
report_vram("with the model loaded and answering")

# The switch, checked against the one call this script can be certain of.
# `serving()` above returns true only because llama-server answered a real HTTP
# request on this very port, so a switch still unarmed here is one that cannot
# arm at all: the line it reads is not a line this build writes.
#
# Measured on 2026-09-08 against b10502 at its default verbosity, which is what
# every launch runs. Six GET /v1/models, the shape of the client's own
# heartbeat, produced not one log line. One chat completion produced seven, all
# of them `slot ...` lines about the work, and the word `request` appears zero
# times in the 220 lines the whole session wrote. So the marker this switch
# greps for is never printed, and the heartbeat that was supposed to hold the
# switch open is invisible here twice over: wrong marker, and a call this build
# does not log either way. The ceiling was the only brake this kernel had.
# What the switch will be watching, established before the session is
# published. A counter that reads is the whole mechanism; a counter that does
# not leaves only the log line, and this build writes none, so say it rather
# than let a brake quietly not exist.
decodes = [decodes_served()]
if decodes[0] is None:
    print("NOTE: this server will not report how many decodes it has run, so "
          "the silence switch has nothing to watch but a log line this build "
          "may never write. This session may not end itself when its client "
          f"goes away, and only the {SESSION_SECONDS} s ceiling applies.",
          flush=True)

# The tunnel is asked for only now, and only under the brakes. cloudflared
# publishes in seconds while the weights take minutes, so by this point the URL
# is almost always already sitting in `tunnel_url`; what this covers is the
# case where it is not.
while tunnel_url[0] is None:
    if tunnel.poll() is not None:
        end_session("cloudflared exited before publishing a tunnel URL", 1)
    if ceiling_reached():
        end_session(f"the agreed ceiling of {SESSION_SECONDS} s ran out before "
                    "cloudflared published a URL")
    if idle_reached():
        end_session(f"nothing has been asked of this server in {IDLE_SECONDS} s, "
                    "so the window that launched it is gone")
    time.sleep(5)
url = tunnel_url[0]
print("TUNNEL_URL=" + url, flush=True)
while server.poll() is None and tunnel.poll() is None:
    # Every beat the client sends is one decode, so the counter moving is the
    # client saying it is still there. Read on the same tick the ceiling is,
    # because the switch can only ever notice at the granularity of this loop.
    served = decodes_served()
    if served is not None and decodes[0] is not None and served != decodes[0]:
        decodes[0] = served
        with last_request_lock:
            last_request[0] = time.monotonic()
    # Whichever comes first. They answer different questions: the ceiling caps
    # what this can ever cost, and the silence says the cost stopped buying
    # anything the moment the other end went away.
    if ceiling_reached():
        end_session(f"the agreed ceiling of {SESSION_SECONDS} s is up")
    if idle_reached():
        end_session(f"nothing has been asked of this server in {IDLE_SECONDS} s, "
                    "so the window that launched it is gone")
    # The same period the ceiling reserves for being asleep, read from the same
    # constant, so shortening one without the other cannot happen quietly.
    time.sleep(CEILING_POLL_SECONDS)
end_session("the model server or tunnel exited", 1)
