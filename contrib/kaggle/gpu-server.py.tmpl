"""Kaggle GPU server for isaacli with optional reusable private inputs."""
import os
import re
import shutil
import subprocess
import tempfile
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

MODEL_REPO = "__MODEL_REPO__"
MODEL_FILE = "__MODEL_FILE__"
MODEL_ALIAS = "__MODEL_ALIAS__"
API_KEY = "__API_KEY__"
CUDA_ARCH = "__CUDA_ARCH__"
MACHINE_SHAPE = "__MACHINE_SHAPE__"
GPU_COUNT = __GPU_COUNT__
SPLIT_MODE = "__SPLIT_MODE__"
PORT = 8080
# The attached inputs are read-only and already expanded by Kaggle.
SCRATCH = tempfile.gettempdir()


def run(command):
    subprocess.run(command, check=True)


def input_file(name):
    matches = list(Path("/kaggle/input").rglob(name))
    if len(matches) != 1:
        raise RuntimeError(f"expected one attached {name}, found {len(matches)}")
    return matches[0]


runtime_root = Path(SCRATCH) / f"llama-cuda-sm{CUDA_ARCH}-b10502"


def optional_input(name):
    matches = list(Path("/kaggle/input").rglob(name))
    return matches[0] if len(matches) == 1 else None


archive = optional_input(f"llama-cuda-sm{CUDA_ARCH}-b10502.tar.gz")
mounted_server = optional_input("llama-server")
if archive:
    run(["tar", "-xzf", str(archive), "-C", SCRATCH])
elif mounted_server:
    shutil.copytree(mounted_server.parent.parent, runtime_root, dirs_exist_ok=True)
else:
    source_dir = Path(SCRATCH) / "llama.cpp"
    run(["git", "clone", "--depth", "1", "--branch", "b10502",
         "https://github.com/ggml-org/llama.cpp", str(source_dir)])
    cuda_driver_candidates = [
        "/usr/local/nvidia/lib64/libcuda.so.1",
        "/usr/lib/x86_64-linux-gnu/libcuda.so.1",
        "/usr/local/cuda/lib64/stubs/libcuda.so",
    ]
    cuda_driver = next(
        (path for path in cuda_driver_candidates if os.path.isfile(path)), None)
    if not cuda_driver:
        raise RuntimeError("CUDA driver library not found")
    run(["cmake", "-S", str(source_dir), "-B", str(source_dir / "build"),
         "-DGGML_CUDA=ON", f"-DCMAKE_CUDA_ARCHITECTURES={CUDA_ARCH}",
         f"-DCUDA_cuda_driver_LIBRARY={cuda_driver}"])
    run(["cmake", "--build", str(source_dir / "build"), "--config",
         "Release", "-j4", "--target", "llama-server"])
    runtime_root.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source_dir / "build" / "bin", runtime_root / "bin")

server_binary = runtime_root / "bin" / "llama-server"
server_binary.chmod(0o755)
model_path = optional_input(MODEL_FILE)
if model_path is None:
    model_path = Path(SCRATCH) / MODEL_FILE
    run(["curl", "-fL", "-o", str(model_path),
         f"https://huggingface.co/{MODEL_REPO}/resolve/main/{MODEL_FILE}"])
def library_path(root):
    """Every directory of the prepared runtime that holds a shared object.

    llama.cpp keeps its own shared libraries next to the binary in bin/, while
    the CUDA runtime lands in lib/, and the RPATH baked into the binary names
    the directory it was compiled in, which does not exist in this session. A
    runtime that arrived as a prepared input is therefore only loadable if the
    search path is derived from the tree that actually arrived: naming lib/
    alone left llama-server unable to open libllama-server-impl.so, after the
    weights had already been downloaded.
    """
    return os.pathsep.join(sorted(
        {str(path.parent) for path in root.rglob("*.so*")}))


server_env = dict(os.environ)
server_env["LD_LIBRARY_PATH"] = os.pathsep.join(
    part for part in (library_path(runtime_root),
                      server_env.get("LD_LIBRARY_PATH", "")) if part)
server_command = [
    str(server_binary),
    "-m", str(model_path), "--alias", MODEL_ALIAS, "-ngl", "99", "-c", "16384",
    "--host", "127.0.0.1", "--port", str(PORT),
    "--jinja", "--api-key", API_KEY,
]
if GPU_COUNT > 1:
    # Splitting layers across cards buys capacity, not speed: for one request
    # at a time, one card computes while the other waits. It is asked for only
    # when the weights plus cache do not fit on a single card.
    server_command.extend(["--split-mode", SPLIT_MODE])
server = subprocess.Popen(server_command, env=server_env)

cloudflared = f"{SCRATCH}/cloudflared"
mounted_cloudflared = optional_input("cloudflared-linux-amd64")
if mounted_cloudflared:
    shutil.copy2(mounted_cloudflared, cloudflared)
elif (runtime_root / "cloudflared-linux-amd64").exists():
    shutil.copy2(runtime_root / "cloudflared-linux-amd64", cloudflared)
else:
    run(["curl", "-fL", "-o", cloudflared,
         "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64"])
run(["chmod", "+x", cloudflared])
tunnel = subprocess.Popen(
    [cloudflared, "tunnel", "--url", f"http://127.0.0.1:{PORT}"],
    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
)
url = None
for line in tunnel.stdout:
    match = re.search(r"https://[-a-z0-9]+\.trycloudflare\.com", line)
    if match:
        url = match.group(0)
        break
if not url:
    raise RuntimeError("cloudflared did not publish a tunnel URL")
threading.Thread(target=lambda: list(tunnel.stdout), daemon=True).start()


def serving():
    """True once llama-server answers, which is not the same as being up."""
    request = urllib.request.Request(
        f"http://127.0.0.1:{PORT}/v1/models",
        headers={"Authorization": "Bearer " + API_KEY})
    try:
        with urllib.request.urlopen(request, timeout=10) as answer:
            return answer.status == 200
    except (urllib.error.URLError, OSError, TimeoutError):
        return False


# The URL is what isaacli turns into a ready profile, so it is published only
# after the server answers. cloudflared publishes its URL in seconds while
# loading tens of gigabytes of weights takes minutes, and announcing the tunnel
# first would hand the user a profile whose first request fails.
print("Waiting for the model server to answer before publishing the URL",
      flush=True)
deadline = time.monotonic() + 3600
while not serving():
    if server.poll() is not None:
        raise RuntimeError("the model server exited before it answered")
    if time.monotonic() > deadline:
        raise RuntimeError("the model server did not answer within an hour")
    time.sleep(10)
print("TUNNEL_URL=" + url, flush=True)
while server.poll() is None and tunnel.poll() is None:
    time.sleep(30)
raise RuntimeError("the model server or tunnel exited")
