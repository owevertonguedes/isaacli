"""Download and publish one model weight without crossing the user's machine."""
import hashlib
import json
import subprocess
import tempfile
from pathlib import Path

import kagglehub


MODEL_REPO = "__MODEL_REPO__"
MODEL_FILE = "__MODEL_FILE__"
MODEL_URL = "__MODEL_URL__"
MODEL_BYTES = int("__MODEL_BYTES__")
MODEL_SHA256 = "__MODEL_SHA256__"
DATASET_REF = "__DATASET_REF__"

with tempfile.TemporaryDirectory(prefix="isaacli-weight-") as temporary:
    folder = Path(temporary)
    target = folder / MODEL_FILE
    subprocess.run(["curl", "-fL", "-o", str(target), MODEL_URL], check=True)
    actual_size = target.stat().st_size
    if actual_size != MODEL_BYTES:
        raise RuntimeError(
            f"weight size mismatch: expected {MODEL_BYTES}, got {actual_size}")
    digest = hashlib.sha256()
    with target.open("rb") as stream:
        for block in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(block)
    actual_sha256 = digest.hexdigest()
    if MODEL_SHA256 and actual_sha256.lower() != MODEL_SHA256.lower():
        raise RuntimeError(
            f"weight SHA-256 mismatch: expected {MODEL_SHA256}, got {actual_sha256}")
    (folder / "isaacli-asset.json").write_text(json.dumps({
        "source_repo": MODEL_REPO,
        "source_url": MODEL_URL,
        "file": MODEL_FILE,
        "size": actual_size,
        "sha256": actual_sha256,
    }, sort_keys=True) + "\n", encoding="utf-8")
    kagglehub.dataset_upload(DATASET_REF, str(folder))
print(f"PREPARED_DATASET={DATASET_REF}", flush=True)
